# MINDMELD - THE HUMAN CONNECTION ENGINE
# Environment Configuration

# Next.js App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase PostgreSQL & Auth (Optional - Mindmeld runs out of the box in Demo Mode without external credentials)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (NEVER expose to client - for server-side admin tasks only)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional: AI Provider (OpenAI / Anthropic / Gemini API for generative idea expansion)
# AI_API_KEY=your-ai-api-key-here

